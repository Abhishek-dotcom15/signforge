# SignForge Environment Variables
# Copy to .env and fill in values

# ======================
# Application
# ======================
NODE_ENV=development
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
LOG_LEVEL=debug

# ======================
# Database
# ======================
POSTGRES_USER=signforge
POSTGRES_PASSWORD=signforge
POSTGRES_DB=signforge
DATABASE_URL=postgresql://signforge:signforge@localhost:5432/signforge

# ======================
# Redis
# ======================
REDIS_URL=redis://localhost:6379/0

# ======================
# Search
# ======================
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# ======================
# AWS S3 (optional)
# ======================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=signforge-assets
CDN_URL=

# ======================
# Auth / JWT
# ======================
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ======================
# CORS
# ======================
CORS_ORIGINS=http://localhost:3000

# ======================
# ML Services
# ======================
TRANSLATION_SERVICE_URL=http://localhost:8001
RECOGNITION_SERVICE_URL=http://localhost:8002
NLP_SERVICE_URL=http://localhost:8003
ASR_SERVICE_URL=http://localhost:8004

# ======================
# Celery
# ======================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ======================
# Frontend
# ======================
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:8002
VITE_CDN_URL=http://localhost:9000

# ======================
# Monitoring (optional)
# ======================
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ======================
# Stripe (optional)
# ======================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ======================
# Port Mapping (Docker)
# ======================
API_PORT=5000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MEILI_PORT=7700
