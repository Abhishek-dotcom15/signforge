{
  "name": "signforge",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Indian Sign Language Communication & Developer Platform",
  "scripts": {
    "start": "concurrently -n api,web -c blue,green \"pnpm run start:api\" \"pnpm run start:web\"",
    "start:api": "cd apps/api && python wsgi.py",
    "start:web": "cd apps/web && pnpm dev",
    "setup": "node scripts/setup-local.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
