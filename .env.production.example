# ============================================================
# SignForge Production Environment Variables
# Copy to .env and fill in all values before deploying
# ============================================================

# --- Application ---
FLASK_ENV=production
NODE_ENV=production
LOG_LEVEL=info

# --- Secrets (REQUIRED — generate unique values) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# --- Database ---
POSTGRES_USER=signforge
POSTGRES_PASSWORD=
POSTGRES_DB=signforge
DATABASE_URL=postgresql://signforge:CHANGE_ME@postgres:5432/signforge

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Search ---
MEILISEARCH_API_KEY=
MEILI_ENV=production

# --- JWT ---
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# --- CORS ---
CORS_ORIGINS=https://yourdomain.com

# --- Frontend ---
VITE_API_URL=/api

# --- AWS S3 (optional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=signforge-assets
CDN_URL=

# --- Monitoring (optional) ---
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Port Mapping ---
API_PORT=5000
WEB_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379
MEILI_PORT=7700
